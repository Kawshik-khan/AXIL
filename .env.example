# CommerceOS environment variables — PLACEHOLDERS ONLY.
# Copy to .env.local and fill in real values there. Never put real secrets in this file (rules/security.md §3).

# ──── Application ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ──── Session & credential secrets (required) ─────────────────
# The app refuses to start if either value is missing, shorter than 32 characters,
# or equal to a published default. Use two different values.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
CREDENTIALS_ENCRYPTION_KEY=

# One-time only, while running scripts/rotate-credential-key.ts: the JWT_SECRET value that
# encrypted the stored channel/connector credentials before CREDENTIALS_ENCRYPTION_KEY existed.
# Remove it after the rotation script reports success.
# OLD_JWT_SECRET=

# ──── Demo / seed accounts ────────────────────────────────────
# Password given to the seeded demo accounts (admin@, superadmin@, support@, ops@, analyst@, security@).
# At least 14 characters. If unset, seeded accounts are created disabled (they cannot log in).
# To set it on an existing data file, run scripts/reset-seed-passwords.ts.
SEED_ADMIN_PASSWORD=

# Local development only: DEV_AUTH_BYPASS=1 together with NODE_ENV=development serves requests that carry
# NO session token as the demo workspace owner. Requests with an invalid token are always rejected.
# Leave unset unless you know you need it.
DEV_AUTH_BYPASS=

# ──── Neon PostgreSQL ─────────────────────────────────────────
# Get from: https://console.neon.tech → Project → Connect (use a least-privilege app role).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL_POOLED=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require

# ──── Inbound courier / payment webhooks (HMAC-SHA256 secrets, >= 24 chars) ──
# Each webhook row references one of these by name (secret_reference). Requests must carry
# x-webhook-signature (hex HMAC-SHA256 of the raw body) and x-webhook-timestamp (unix ms, <= 300 s old).
STEADFAST_WEBHOOK_SECRET=
PATHAO_WEBHOOK_SECRET=
BKASH_WEBHOOK_SECRET=
NAGAD_WEBHOOK_SECRET=

# ──── Meta (Facebook / Instagram / WhatsApp) webhooks ─────────
# App secret used to verify X-Hub-Signature-256 when a channel has no per-channel app secret.
META_APP_SECRET=
# Token Meta echoes during webhook verification (GET hub.challenge).
META_VERIFY_TOKEN=

# ──── Pinecone Vector DB ──────────────────────────────────────
# Get from: https://app.pinecone.io → API Keys
PINECONE_API_KEY=
PINECONE_INDEX=commerceos-knowledge

# ──── Upstash Redis ───────────────────────────────────────────
# Get from: https://console.upstash.com → Redis → Details
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ──── Default workspace localization ──────────────────────────
DEFAULT_CURRENCY=BDT
DEFAULT_TIMEZONE=Asia/Dhaka
DEFAULT_LANGUAGE=en

# ──── TypeSafe AI / Jev System One ────────────────────────────
# Get from: https://typesafe.ai → API Keys
TYPESAFE_API_KEY=
TYPESAFE_API_URL=https://api.typesafe.ai/v1

# --- Reverse proxy (Phase 1, FX-14) ---
# Set TRUST_PROXY=1 only when the app runs behind your own reverse proxy that appends X-Forwarded-For.
# TRUST_PROXY_HOPS = number of proxies in front of the app (default 1). Enables per-client rate limits.
TRUST_PROXY=
TRUST_PROXY_HOPS=

# --- JSON store persistence (Phase 2, FX-20 / FX-24) ---
# Writes are coalesced and flushed every PERSIST_DEBOUNCE_MS (default 250). COMMERCEOS_DATA_DIR overrides ./.data.
PERSIST_DEBOUNCE_MS=
COMMERCEOS_DATA_DIR=
# The app refuses to start when another process or host owns the store.
# 1 = take over a lock owned by another host. Only when that host is certainly gone.
COMMERCEOS_FORCE_LOCK=

# --- Store backend (Phase 4, ADR-108) ---
# Unset (default): the JSON file above. `pg`: Postgres is the system of record (DATABASE_URL_POOLED, else
# DATABASE_URL). Before switching: `npm run db:migrate`, then the backfill (`npm run db:backfill`, see ADR-108).
DATA_BACKEND=
# Several app servers may share the Postgres store (ADR-109). Reads see other servers' changes at most this late (ms;
# default 1000; 0 = sync before every read request). Writes always start from the latest committed state.
STORE_SYNC_INTERVAL_MS=
# A read refuses (503) when this server couldn't sync for this long (ms; default 30000).
STORE_MAX_STALENESS_MS=
# A write request waits at most this long for this server's store lock, then gets 503 (ms; default 15000).
STORE_LOCK_WAIT_MS=
# Request bodies: largest accepted (bytes; default 20 MB) and longest time to receive one (ms; default 15000).
STORE_MAX_BODY_BYTES=
STORE_BODY_READ_TIMEOUT_MS=
# Connections the store's pool may open (default 5).
STORE_POOL_MAX=

# --- n8n (Phase 3, FX-31; Phase 5, FX-55) ---
# Base URL of your n8n instance, e.g. http://localhost:5678. Without it (and without an n8n instance configured in
# the app) automations don't call n8n and executions fail with N8N_NOT_CONFIGURED.
N8N_HOST=
# Signs every call to n8n (X-CommerceOS-Timestamp / X-CommerceOS-Signature, see n8n/deployment/import.md) so the
# workflows can refuse forged calls. 32+ random characters; the same value goes into the n8n environment.
COMMERCEOS_N8N_WEBHOOK_SECRET=

# --- Outbound requests (Phase 5, ADR-110) ---
# Every request to an external URL goes through an SSRF guard: https only, never a private, loopback or link-local
# address. Comma-separated host:port pairs listed here may be reached anyway (plain http allowed) by platform-owned
# records only, e.g. an n8n instance stored in the app: "10.0.0.5:5678". URLs that tenants enter (webhook targets,
# connector endpoints) never use this list. URLs from this file itself (N8N_HOST, LLM_BASE_URL) don't need it.
OUTBOUND_ALLOWED_PRIVATE_HOSTS=
# 0 turns off the background delivery of enterprise webhooks on this server (default: on).
WEBHOOK_WORKER=

# --- AI provider (Phase 3, FX-32) ---
# Any OpenAI-compatible server: OpenAI, OpenRouter, Groq, DeepSeek, Ollama (http://localhost:11434/v1), vLLM.
# Without LLM_BASE_URL, AI features answer 424 AI_PROVIDER_NOT_CONFIGURED unless AI_DEMO_MODE=1 (offline keyword demo,
# labelled "Demo AI" in the UI). Changing the embedding model changes vector dimensions: re-index the knowledge base.
LLM_BASE_URL=
LLM_API_KEY=
LLM_PROVIDER_NAME=
LLM_MODEL_FAST=
LLM_MODEL_REASONING=
LLM_EMBEDDING_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
AI_DEMO_MODE=
# Optional: {"TIER_1_FAST":{"promptCostPer1M":0.15,"completionCostPer1M":0.6}} and the USD to BDT rate for cost display
LLM_PRICING_JSON=
USD_BDT_RATE=
