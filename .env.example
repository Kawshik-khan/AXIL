# CommerceOS environment variables — PLACEHOLDERS ONLY.
# Copy to .env.local and fill in real values there. Never put real secrets in this file (rules/security.md §3).

# ──── Application ─────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ──── Session & credential secrets (required) ─────────────────
# The app refuses to start if either value is missing, shorter than 32 characters,
# or equal to a published default. Use two different values.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
CREDENTIALS_ENCRYPTION_KEY=

# One-time only, while running scripts/rotate-credential-key.ts: the JWT_SECRET value that
# encrypted the stored channel/connector credentials before CREDENTIALS_ENCRYPTION_KEY existed.
# Remove it after the rotation script reports success.
# OLD_JWT_SECRET=

# ──── Demo / seed accounts ────────────────────────────────────
# Password given to the seeded demo accounts (admin@, superadmin@, support@, ops@, analyst@, security@).
# At least 14 characters. If unset, seeded accounts are created disabled (they cannot log in).
# To set it on an existing data file, run scripts/reset-seed-passwords.ts.
SEED_ADMIN_PASSWORD=

# Local development only: DEV_AUTH_BYPASS=1 together with NODE_ENV=development serves requests that carry
# NO session token as the demo workspace owner. Requests with an invalid token are always rejected.
# Leave unset unless you know you need it.
DEV_AUTH_BYPASS=

# ──── Neon PostgreSQL ─────────────────────────────────────────
# Get from: https://console.neon.tech → Project → Connect (use a least-privilege app role).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL_POOLED=postgresql://USER:PASSWORD@HOST-pooler/DB?sslmode=require

# ──── Inbound courier / payment webhooks (HMAC-SHA256 secrets, >= 24 chars) ──
# Each webhook row references one of these by name (secret_reference). Requests must carry
# x-webhook-signature (hex HMAC-SHA256 of the raw body) and x-webhook-timestamp (unix ms, <= 300 s old).
STEADFAST_WEBHOOK_SECRET=
PATHAO_WEBHOOK_SECRET=
BKASH_WEBHOOK_SECRET=
NAGAD_WEBHOOK_SECRET=

# ──── Meta (Facebook / Instagram / WhatsApp) webhooks ─────────
# App secret used to verify X-Hub-Signature-256 when a channel has no per-channel app secret.
META_APP_SECRET=
# Token Meta echoes during webhook verification (GET hub.challenge).
META_VERIFY_TOKEN=

# ──── Pinecone Vector DB ──────────────────────────────────────
# Get from: https://app.pinecone.io → API Keys
PINECONE_API_KEY=
PINECONE_INDEX=commerceos-knowledge

# ──── Upstash Redis ───────────────────────────────────────────
# Get from: https://console.upstash.com → Redis → Details
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ──── Default workspace localization ──────────────────────────
DEFAULT_CURRENCY=BDT
DEFAULT_TIMEZONE=Asia/Dhaka
DEFAULT_LANGUAGE=en

# ──── TypeSafe AI / Jev System One ────────────────────────────
# Get from: https://typesafe.ai → API Keys
TYPESAFE_API_KEY=
TYPESAFE_API_URL=https://api.typesafe.ai/v1
