{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run type-check)",
      "Bash(npm test)",
      "Bash(node tests/ts-runner.cjs:*)",
      "Bash(npm run dev)",
      "Bash(npm run build)",
      "Bash(ls:*)",
      "Bash(wc:*)",
      "Bash(grep:*)",
      "Bash(find:*)"
    ],
    "ask": [
      "Bash(npm run db:migrate)",
      "Bash(npm run db:seed:*)",
      "Bash(npm run test:db)",
      "Bash(npm run n8n:*)",
      "Bash(npm install:*)",
      "Bash(npm i:*)"
    ],
    "deny": [
      "Read(./.env.local)",
      "Read(./.env)",
      "Read(./.data/**)",
      "Edit(./.data/**)",
      "Edit(./.backups/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.cjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/scan-new-code.cjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
