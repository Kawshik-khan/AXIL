{
  "id": "wf_pay_01",
  "name": "CommerceOS — Payment Verification & Reconciliation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "commerceos-payment-webhook",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "payment-webhook-trigger",
      "name": "Payment Gateway Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [240, 300],
      "webhookId": "commerceos-payment-webhook"
    },
    {
      "parameters": {
        "jsCode": "// 1. Extract and sanitize payment gateway IPN / webhook data\nconst input = $input.first().json;\nconst body = input.body || input;\nconst headers = input.headers || {};\n\nconst trxId = body.trxID || body.transaction_id || body.payment_id;\nconst amount = Number(body.amount || 0);\nconst provider = (body.provider || 'BKASH').toUpperCase();\n\nif (!trxId) {\n  throw new Error('VALIDATION_ERROR: Missing transaction ID in payment callback');\n}\n\nreturn [{\n  json: {\n    provider: provider,\n    transaction_id: trxId,\n    amount: amount,\n    order_id: body.order_id || body.merchant_invoice_number,\n    currency: body.currency || 'BDT',\n    customer_msisdn: body.customer_msisdn || body.payer_account,\n    correlation_id: `pay_${trxId}`,\n    idempotency_key: `idemp_pay_${provider.toLowerCase()}_${trxId}`,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "sanitize-payment-data",
      "name": "Sanitize Payment Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [480, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.COMMERCEOS_API_BASE_URL || 'http://localhost:3000' }}/api/v1/automation/webhooks/{{ $json.provider.toLowerCase() }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Correlation-ID",
              "value": "={{ $json.correlation_id }}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{ $json.idempotency_key }}"
            },
            {
              "name": "X-Tenant-ID",
              "value": "={{ $json.tenant_id || 'ten_default_dhaka' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 10000,
          "retry": {
            "maxRetries": 3,
            "retryInterval": 1000
          }
        }
      },
      "id": "verify-with-commerceos",
      "name": "Verify with CommerceOS Gateway",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [720, 300],
      "credentials": {
        "httpHeaderAuth": {
          "id": "commerceos-api-credential",
          "name": "CommerceOS API"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "pay-verified",
              "leftValue": "={{ $json.success }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "evaluate-payment-outcome",
      "name": "Evaluate Payment Outcome",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [960, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, verified: true, message: 'Payment transaction validated and credited to order', timestamp: new Date().toISOString() }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-payment-success",
      "name": "Respond Payment Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1200, 200]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: false, error: 'Payment verification failed or duplicate transaction rejected', timestamp: new Date().toISOString() }) }}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "respond-payment-failure",
      "name": "Respond Payment Failure",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1200, 420]
    }
  ],
  "connections": {
    "Payment Gateway Webhook Trigger": {
      "main": [
        [
          {
            "node": "Sanitize Payment Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Sanitize Payment Data": {
      "main": [
        [
          {
            "node": "Verify with CommerceOS Gateway",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Verify with CommerceOS Gateway": {
      "main": [
        [
          {
            "node": "Evaluate Payment Outcome",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Evaluate Payment Outcome": {
      "main": [
        [
          {
            "node": "Respond Payment Success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond Payment Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": true,
    "saveManualExecutions": true,
    "availableInMCP": true
  },
  "versionId": "d9918273-5566-7788-9900-112233445566",
  "meta": {
    "templateCredsSetupCompleted": true,
    "instanceId": "commerceos-prod-n8n"
  },
  "tags": [
    {
      "name": "CommerceOS"
    },
    {
      "name": "Payment Automation"
    },
    {
      "name": "Phase 6"
    }
  ]
}
