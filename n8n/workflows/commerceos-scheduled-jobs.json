      "id": "sched-courier-poll",
      "name": "Schedule: courier-poll",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        200
      ],
      "notes": "Every 30 minutes"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($vars.COMMERCEOS_API_BASE_URL || $env.COMMERCEOS_API_BASE_URL) }}/api/v1/jobs/courier-poll/run",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Idempotency-Key",
              "value": "=courier-poll:{{ $now.toISO() }}"
            }
          ]
        },
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "call-courier-poll",
      "name": "Run job: courier-poll",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        520,
        200
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "",
          "name": "CommerceOS Jobs Token"
        }
      },
      "notes": "Header Auth credential: name Authorization, value 'Bearer <job token>'. CommerceOS stores only its SHA-256 (JOBS_TOKEN_SHA256)."
    },
