{
  "id": "wf_del_02",
  "name": "CommerceOS — Courier Status Synchronization",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "commerceos-courier-webhook",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "courier-webhook-trigger",
      "name": "Courier Inbound Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "commerceos-courier-webhook"
    },
    {
      "parameters": {
        "jsCode": "// Extract and validate inbound courier callback\nconst input = $input.first().json;\nconst headers = input.headers || {};\nconst body = input.body || input;\n\nconst provider = headers['x-courier-provider'] || body.courier_provider || 'STEADFAST';\nconst trackingCode = body.tracking_code || body.tracking_number || body.consignment_id;\nconst status = body.status || body.delivery_status || 'in_transit';\n\nif (!trackingCode) {\n  throw new Error('VALIDATION_ERROR: Missing tracking_code or consignment_id');\n}\n\nreturn [{\n  json: {\n    provider: provider.toUpperCase(),\n    tracking_code: trackingCode,\n    status: status,\n    status_details: body.status_details || body.reason || '',\n    location: body.location || body.hub || '',\n    event_timestamp: body.timestamp || new Date().toISOString(),\n    correlation_id: trackingCode,\n    idempotency_key: `csync_${provider.toLowerCase()}_${trackingCode}_${status}`\n  }\n}];"
      },
      "id": "normalize-courier-payload",
      "name": "Normalize Courier Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($vars.COMMERCEOS_API_BASE_URL || $env.COMMERCEOS_API_BASE_URL) }}/api/v1/automation/webhooks/{{ $json.provider.toLowerCase() }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-Correlation-ID",
              "value": "={{ $json.correlation_id }}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{ $json.idempotency_key }}"
            },
            {
              "name": "X-Tenant-ID",
              "value": "={{ $json.tenant_id || 'ten_default_dhaka' }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 10000,
          "retry": {
            "maxRetries": 3,
            "retryInterval": 1000
          }
        }
      },
      "id": "post-to-commerceos-gateway",
      "name": "Post to Webhook Gateway",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "commerceos-api-credential",
          "name": "CommerceOS API"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "check-sync",
              "leftValue": "={{ $json.success }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "check-gateway-result",
      "name": "Check Gateway Result",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        960,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: true, verified: true, data: $json, timestamp: new Date().toISOString() }) }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-courier-success",
      "name": "Respond Courier Success",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1200,
        200
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ success: false, error: 'Courier status synchronization rejected by CommerceOS', timestamp: new Date().toISOString() }) }}",
        "options": {
          "responseCode": 400
        }
      },
      "id": "respond-courier-failure",
      "name": "Respond Courier Failure",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1200,
        420
      ]
    }
  ],
  "connections": {
    "Courier Inbound Webhook Trigger": {
      "main": [
        [
          {
            "node": "Normalize Courier Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Normalize Courier Payload": {
      "main": [
        [
          {
            "node": "Post to Webhook Gateway",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Post to Webhook Gateway": {
      "main": [
        [
          {
            "node": "Check Gateway Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check Gateway Result": {
      "main": [
        [
          {
            "node": "Respond Courier Success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Respond Courier Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "saveExecutionProgress": true,
    "saveManualExecutions": true,
    "availableInMCP": true
  },
  "versionId": "c8821900-1122-4433-8899-abcdef012345",
  "meta": {
    "templateCredsSetupCompleted": true,
    "instanceId": "commerceos-prod-n8n"
  },
  "tags": [
    {
      "name": "CommerceOS"
    },
    {
      "name": "Shipping Automation"
    },
    {
      "name": "Phase 6"
    }
  ]
}
