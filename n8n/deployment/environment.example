# ============================================================
# COMMERCEOS PRODUCTION N8N ENVIRONMENT VARIABLES
# ============================================================

# Application Runtime URL
# Used by n8n HTTP Request nodes to communicate with CommerceOS
COMMERCEOS_API_BASE_URL=https://api.commerceos.com.bd

# n8n General Settings
N8N_HOST=n8n.commerceos.com.bd
N8N_PORT=5678
N8N_PROTOCOL=https
NODE_ENV=production

# Webhook Tunnel / Ingress URL
WEBHOOK_URL=https://n8n.commerceos.com.bd/

# n8n Security & Encryption Key (Generate via: openssl rand -hex 32)
N8N_ENCRYPTION_KEY=replace_with_32_byte_secure_hex_key

# Execution Retention & Logging
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=168
EXECUTIONS_DATA_PRUNE_MAX_COUNT=50000
N8N_LOG_LEVEL=info

# Concurrency & Performance
N8N_CONCURRENCY_PRODUCTION_LIMIT=20
EXECUTIONS_TIMEOUT=120
EXECUTIONS_TIMEOUT_MAX=300

# CommerceOS calls (Phase 5, FX-55). The same secret is set on the CommerceOS server; the Code nodes verify every call
# with it, so they need env access and the crypto module. Locally, n8n/deployment/setup-local-n8n.mjs writes n8n/.env.
COMMERCEOS_N8N_WEBHOOK_SECRET=replace_with_the_same_random_value_as_commerceos
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
NODE_FUNCTION_ALLOW_BUILTIN=crypto
# Who gets the low-stock SMS (business configuration, not hard-coded in the workflow)
COMMERCEOS_OPERATOR_ALERT_PHONE=

# Optional Sentry / Telemetry Monitoring
# N8N_SENTRY_DSN=
